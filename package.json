{
  "name": "dsh-weneed-adapter",
  "version": "1.0.0",
  "description": "Inject a WeNeed register seed into DSH model requests by registering a delegating LLM adapter.",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "channels.js",
    "transport.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "selftest.mjs",
    "integration.mjs",
    "list-channels.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
