{
  "name": "dsh-weneed-adapter",
  "version": "1.1.0",
  "description": "Inject a WeNeed register seed into DSH model requests by registering a delegating LLM adapter.",
  "type": "module",
  "license": "MIT",
  "author": "darkluobo-game",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "llm",
    "plugin",
    "adapter",
    "prompt",
    "weneed",
    "register"
  ],
  "homepage": "https://github.com/darkluoboct/dsh-weneed-adapter#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/darkluoboct/dsh-weneed-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/darkluoboct/dsh-weneed-adapter/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "channels.js",
    "transport.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "selftest.mjs",
    "client-smoke.mjs",
    "integration.mjs",
    "list-channels.mjs",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
